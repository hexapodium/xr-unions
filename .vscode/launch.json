    "version": "0.2.0",
    "configurations": [
    {
        "name": "Launch via NVS (node)",
        "request": "launch",
        "runtimeArgs": [
            "exec",
            "krypton",
            "node"
        ],
        "windows": { "runtimeExecutable": "nvs.cmd" },
        "osx": { "runtimeExecutable": "nvs" },
        "linux": { "runtimeExecutable": "nvs" },
        "program": "${workspaceFolder}/scripts/cache-airtable.js",
        "skipFiles": [
            "<node_internals>/**"
        ],
        "type": "node",
        "envFile": "${workspaceFolder}/.env"
    },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${file}",
            "runtimeArgs": [
                "exec",
                "krypton",
                "node"
            ],
            "windows": { "runtimeExecutable": "nvs.cmd" },
            "osx": { "runtimeExecutable": "nvs" },
            "linux": { "runtimeExecutable": "nvs" },
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}